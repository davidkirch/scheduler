# Auth
BETTER_AUTH_URL=<your_application_url> #i.e. https://scheduler.homelab.com
BETTER_AUTH_SECRET=<random_min_32_char_secret> # generate with openssl rand -base64 32
GITHUB_CLIENT_ID= # if unset the github auth provider will be unavailable
GITHUB_CLIENT_SECRET= # if unset the github auth provider will be unavailable

# Database
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=
DATABASE_HOST=
DATABASE_PORT=
DATABASE_URL=postgresql://${DATABASE_USER}:${DATABASE_PASSWORD}@${DATABASE_HOST}:${DATABASE_PORT}/${DATABASE_NAME}

# Docker compose deployment (compose.yml builds DATABASE_URL and BETTER_AUTH_URL itself;
# only BETTER_AUTH_SECRET and the GitHub pair from above are also needed)
DOMAIN= # i.e. scheduler.example.com
POSTGRES_PASSWORD= # generate with openssl rand -hex 24 (hex keeps it URL-safe)
CF_DNS_API_TOKEN= # Cloudflare token with Zone:DNS:Edit for the domain's zone
